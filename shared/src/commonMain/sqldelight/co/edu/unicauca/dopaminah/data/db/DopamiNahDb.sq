CREATE TABLE gamification (
    id INTEGER PRIMARY KEY NOT NULL,
    streak INTEGER NOT NULL DEFAULT 0,
    total_points INTEGER NOT NULL DEFAULT 0,
    best_streak INTEGER NOT NULL DEFAULT 0,
    last_opened_day INTEGER NOT NULL DEFAULT -1
);

getGamification:
SELECT * FROM gamification WHERE id = 1;

insertOrReplaceGamification:
INSERT OR REPLACE INTO gamification (id, streak, total_points, best_streak, last_opened_day)
VALUES (1, ?, ?, ?, ?);

---

CREATE TABLE web_goals (
    id TEXT PRIMARY KEY NOT NULL,
    domain TEXT NOT NULL,
    display_url TEXT NOT NULL DEFAULT '',
    daily_time_limit_minutes INTEGER NOT NULL DEFAULT 0,
    is_active INTEGER NOT NULL DEFAULT 1
);

getAllWebGoals:
SELECT * FROM web_goals;

insertWebGoal:
INSERT OR REPLACE INTO web_goals (id, domain, display_url, daily_time_limit_minutes, is_active)
VALUES (?, ?, ?, ?, ?);

deleteAllWebGoals:
DELETE FROM web_goals;

---

CREATE TABLE web_accumulated_minutes (
    domain TEXT PRIMARY KEY NOT NULL,
    minutes INTEGER NOT NULL DEFAULT 0
);

getAllAccumulatedMinutes:
SELECT * FROM web_accumulated_minutes;

insertAccumulatedMinute:
INSERT OR REPLACE INTO web_accumulated_minutes (domain, minutes)
VALUES (?, ?);

deleteAllAccumulatedMinutes:
DELETE FROM web_accumulated_minutes;

---

CREATE TABLE app_limit_goals (
    id INTEGER PRIMARY KEY NOT NULL,
    goal_type TEXT NOT NULL,
    package_name TEXT NOT NULL DEFAULT '',
    app_display_name TEXT NOT NULL DEFAULT '',
    max_time_millis INTEGER NOT NULL DEFAULT 0,
    max_unlocks INTEGER NOT NULL DEFAULT 0,
    current_streak INTEGER NOT NULL DEFAULT 0
);

getAllAppLimitGoals:
SELECT * FROM app_limit_goals ORDER BY id;

getAppLimitGoalById:
SELECT * FROM app_limit_goals WHERE id = ?;

insertAppLimitGoal:
INSERT OR REPLACE INTO app_limit_goals (id, goal_type, package_name, app_display_name, max_time_millis, max_unlocks, current_streak)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteAppLimitGoal:
DELETE FROM app_limit_goals WHERE id = ?;

getNextAppLimitGoalId:
SELECT COALESCE(MAX(id), 0) + 1 FROM app_limit_goals;
